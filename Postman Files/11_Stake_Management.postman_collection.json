      "name": "Create Stake",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-API-Key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{user_id}}\",\n  \"contractAddress\": \"{{contract_address}}\",\n  \"amount\": \"{{amount}}\",\n  \"lockPeriod\": 30\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/stakes",
          "host": ["{{base_url}}"],
          "path": ["api", "stakes"]
        }
      },
      "response": []
    },
