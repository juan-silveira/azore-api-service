# ========================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# ========================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=azore_blockchain_service
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_DIALECT=postgres
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ========================================
# SEGURANÇA
# ========================================
# Chave de 32 caracteres para criptografia AES-256-GCM
# GERE UMA CHAVE SEGURA E ALEATÓRIA!
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Chave privada do admin do sistema para conceder roles
# GERE UMA CHAVE SEGURA E ALEATÓRIA!
ADMIN_PRIVATE_KEY=your_admin_private_key_here

# ========================================
# DADOS DO ADMIN PADRÃO
# ========================================
# Admin principal do sistema (admin.service.js)
DEFAULT_ADMIN_EMAIL=admin@azore.technology
DEFAULT_ADMIN_PASSWORD=azore@admin123
DEFAULT_ADMIN_NAME=Admin
DEFAULT_ADMIN_CPF=00000000000
DEFAULT_ADMIN_PHONE=11999999999
DEFAULT_ADMIN_BIRTH_DATE=1990-01-01

# ========================================
# DADOS DO CLIENT PADRÃO
# ========================================
DEFAULT_CLIENT_NAME=Azore
DEFAULT_CLIENT_RATE_LIMIT_REQUESTS_PER_MINUTE=1000
DEFAULT_CLIENT_RATE_LIMIT_REQUESTS_PER_HOUR=10000
DEFAULT_CLIENT_RATE_LIMIT_REQUESTS_PER_DAY=100000

# ========================================
# CONFIGURAÇÃO DE TESTES
